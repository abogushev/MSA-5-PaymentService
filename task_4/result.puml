@startuml
title Платёжный процесс OrchestrPay

start

:Инициирование платежа;

  :Списание средств с клиента;

  fork
    :Антифрод-проверка;
    if (Результат?)
      :APPROVED;
    else if (Запрет)
      :REJECTED;
    else if (Ручная проверка)
      :Ожидание 20 минут;
      if (Решение оператора?) then ()
        :APPROVED;
      else ()
        :REJECTED;
      endif
    endif

  end fork

if (Все проверки пройдены?) then (да)
  :Перевод контрагенту;
  :Статус COMPLETED;

  partition Уведомления {
    :Уведомление клиента;
    :Уведомление контрагента;
  }

  stop
else (нет)
  :Возврат средств;
  :Статус REFUNDED;

  if (Причина - антифрод?) then (да)
    :Уведомить безопасность;
  else (нет)
    :Записать в лог;
  endif

  :Уведомление об отказе клиента;
  stop
endif

@enduml
